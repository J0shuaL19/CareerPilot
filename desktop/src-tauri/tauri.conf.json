{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CareerPilot",
  "mainBinaryName": "CareerPilot",
  "version": "0.1.0",
  "identifier": "com.careerpilot.desktop",
  "build": {
    "beforeDevCommand": {
      "cwd": "../../frontend",
      "script": "pnpm dev",
      "wait": false
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-resources.ps1",
      "wait": true
    },
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CareerPilot",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/": ""
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}